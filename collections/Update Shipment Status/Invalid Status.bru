meta {
  name: Update Shipment Status - Invalid Status
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/v1/shipments/{{shipmentId}}/status
  body: json
  auth: none
}

headers {
  Creator: {{creator}}
  Content-Type: application/json
}

body:json {
  {
    "status": "invalid_status"
  }
}

docs {
  **Erro**: Tenta atualizar com status inválido
  - Resposta esperada: 400 Bad Request
  - Erro: Status deve ser um dos valores válidos
  - Valores válidos: "pending", "in_transit", "delivered", "cancelled"
  - O status fornecido não é válido
}
