meta {
  name: Create Shipment - Happy Path
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/shipments
  body: json
  auth: none
}

headers {
  Creator: {{creator}}
  Content-Type: application/json
}

body:json {
  {
    "packageName": "Playstation 5 Slim",
    "weight": 15,
    "dimensions": {
      "length": 20,
      "width": 15,
      "height": 20
    },
    "shippingCost": 20,
    "destinationAddress": "Santa Luzia"
  }
}

docs {
  **Sucesso**: Cria um novo envio com dados válidos
  - Resposta esperada: 201 Created
  - Retorna os dados do envio criado com uuid, datas e status "pending"
}
