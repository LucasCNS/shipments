      "width": 0,
      "height": 2
    },
    "originZipCode": "30000000",
    "destinationZipCode": "35060000",
    "destinationAddress": ""
  }
}

docs {
  **Erro**: Tenta criar com dados inválidos
  - Resposta esperada: 400 Bad Request
  - Erros esperados: packageName contém caracteres especiais, weight <= 0, dimensions inválidas, etc
